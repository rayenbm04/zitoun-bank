# Copier ce fichier en ".env" puis adapter les valeurs
PORT=3000
CLIENT_URL=http://localhost:4200

# MySQL (XAMPP : utilisateur root, mot de passe vide par défaut)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zitoun_bank

# Clé secrète pour signer les jetons de connexion (mettre une longue chaîne aléatoire)
JWT_SECRET=remplacer_par_une_longue_chaine_secrete
JWT_EXPIRES_IN=7d
